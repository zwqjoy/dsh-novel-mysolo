{
  "name": "dsh-novel-mysolo",
  "version": "0.1.0",
  "description": "小说创作定制版：预设 novel-mysolo，主代理写作、八项质量检查、有限修复，无子代理。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "dsh-plugin",
    "novel",
    "settings"
  ],
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./plugins": {
      "default": "./template/plugins/llm-tool-choice-pin/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "files": [
    "lib",
    "template",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    }
  },
  "private": true
}
